# Copy to .env and fill in. Docker Compose reads this file for the n8n stack.
# Real values never go into git: .env and .env.local are ignored.

# Shared HMAC secret for Convex <-> n8n. Generate one with: openssl rand -hex 32
# Set the same value in Convex: npx convex env set AUTOMATION_SECRET <value>
AUTOMATION_SECRET=

# Base URL of the Convex HTTP actions, without a trailing slash.
#   Cloud deployment:  https://<your-deployment>.convex.site
#   Local deployment:  http://host.docker.internal:3211
CONVEX_SITE_URL=

# Optional.
# N8N_PORT=5678
# MAILPIT_PORT=8025
# TIMEZONE=UTC
# OPS_EMAIL=ops@lendloop.test

# ---------------------------------------------------------------------------
# Next.js reads its own values from .env.local:
#
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
#   CLERK_SECRET_KEY=sk_test_...
#   NEXT_PUBLIC_CONVEX_URL=...        (written by `npx convex dev`)
#
# Convex keeps its values in the deployment (`npx convex env set NAME value`):
#
#   CLERK_JWT_ISSUER_DOMAIN   Clerk Frontend API URL, e.g. https://xxx.clerk.accounts.dev
#   ADMIN_EMAILS              comma-separated emails that get the admin role
#   AUTOMATION_SECRET         same value as above
#   N8N_WEBHOOK_URL           e.g. http://localhost:5678/webhook/lendloop/loan-event
